# ---- Database ----
DATABASE_URL=postgres://kb:kb@localhost:5432/kb

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=kb

# ---- API ----
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- Object storage ----
# MVP dev: local filesystem. Later: s3 | azure-blob.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- AI providers ----
# Provider mode: openai | fake. Leave unset to auto-detect:
#   OPENAI_API_KEY present -> openai ; missing (dev) -> fake.
# Production fails fast if it would silently use fake.
# AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for Azure OpenAI / proxies

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_MODEL=gpt-4o-mini

# ---- Worker ----
WORKER_CONCURRENCY=4

# ---- Hybrid retrieval tuning (API) ----
RETRIEVAL_CANDIDATE_POOL=30
RETRIEVAL_VECTOR_WEIGHT=0.65
RETRIEVAL_KEYWORD_WEIGHT=0.35
RETRIEVAL_MAX_PER_DOC=3
RETRIEVAL_HIGH_RELEVANCE=0.85
RETRIEVAL_TOKEN_BUDGET=6000

# ---- Connectors / OAuth ----
# Required to use connectors. Generate: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# OAUTH_STATE_SECRET=            # falls back to JWT_SECRET if unset
# Google Drive (redirect URI: $API_PUBLIC_URL/connectors/gdrive/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SharePoint / Microsoft Graph (redirect URI: $API_PUBLIC_URL/connectors/sharepoint/callback)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
